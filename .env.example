# Core Service - PostgreSQL
CORE_DB_NAME=core_db
CORE_DB_USER=core_user
CORE_DB_PASSWORD=change-me
CORE_DB_PORT=5434

# Notification Service - PostgreSQL
NOTIF_DB_NAME=notif_db
NOTIF_DB_USER=notif_user
NOTIF_DB_PASSWORD=change-me
NOTIF_DB_PORT=5433

# RabbitMQ
RABBITMQ_USER=ortakpay
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT (Core Service auth) - must be at least 32 bytes (256 bits) for HS256.
# Generate a real one for anything beyond local dev, e.g.: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-please-override-in-real-env-1234567890
